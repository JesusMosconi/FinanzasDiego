# Exclusivo de la rama demo. Usar una rama Neon solo esquema y vacía.
DEMO_MODE="true"
DEMO_DATABASE_HOST="HOST_POOLER_DE_LA_RAMA_DEMO"
# DATABASE_URL: conexión pooled de esa misma rama Neon.
# DIRECT_URL: conexión directa de esa misma rama, sin pooler.
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require"
DIRECT_URL="postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require"
# Hash bcrypt de 1234 para la demo. Usar los $ normales en .env.demo.local.
PIN_HASH="REEMPLAZAR_CON_HASH_BCRYPT"
JWT_SECRET="SECRETO_ALEATORIO_EXCLUSIVO_DE_LA_DEMO"
# Solo al ejecutar npm.cmd run demo:seed.
DEMO_SEED_CONFIRM="CREAR_DATOS_FICTICIOS"
