# DATABASE_URL: conexion pooled de Neon (el host debe incluir -pooler).
# DIRECT_URL: conexion directa de Neon, sin pooler, usada solo para migraciones.
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require"
DIRECT_URL="postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require"
PIN_HASH="REEMPLAZAR_CON_HASH_BCRYPT"
JWT_SECRET="REEMPLAZAR_CON_UN_SECRETO_ALEATORIO_SEGURO"
